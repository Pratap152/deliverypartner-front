pipeline {
    agent {
        docker {
            image 'pratap1371/rider-build-env:latest'
            args '-u root:root -v /gradle:/gradle -v /root/.gradle:/root/.gradle'
        }
    }

    environment {
        AWS_BUCKET = "deliverypartner"
        APK_PATH = "android/app/build/outputs/apk/release/app-release.apk"
        APK_NAME = "rider-app-${BUILD_NUMBER}.apk"
    }

    tools {
        nodejs "node20"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'merge-final-dev', url: 'https://github.com/Pratap152/rider-app.git'
            }
        }

        stage('Cleanup Workspace') {
            steps {
                sh '''
                rm -rf node_modules
                rm -rf android/build
                rm -rf android/app/build
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Fix Gradle Permission') {
            steps {
                sh 'chmod +x android/gradlew'
            }
        }

        stage('Build APK') {
            steps {
                dir('android') {
                    sh './gradlew assembleRelease'
                }
            }
        }

        stage('Verify APK') {
            steps {
                sh 'ls -lh android/app/build/outputs/apk/release/'
            }
        }

        stage('Rename APK with Version') {
            steps {
                sh """
                cp ${APK_PATH} ${APK_NAME}
                """
            }
        }

        stage('Upload APK to S3') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh """
                    aws s3 cp ${APK_NAME} s3://${AWS_BUCKET}/${APK_NAME}
                    """
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: '*.apk', fingerprint: true
            }
        }
    }
}
